WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_THREADS=4
MAX_UPLOAD_MB=200
MAX_DURATION_SECONDS=3600
MAX_CONCURRENT_JOBS=1
MAX_PENDING_JOBS=8
JOB_TTL_SECONDS=3600
TASK_TIMEOUT_SECONDS=7200
# DATA_DIR=/absolute/path/to/private-temp-directory
# 本地语音识别不需要云端 ASR 密钥；未来云端 ASR 的密钥仅放此文件。

# Google 登录（Google Cloud 中创建“Web 应用”OAuth 客户端）
# 未配置 ID / Secret 时游客仍可使用，Google 登录显示暂不可用。
PUBLIC_BASE_URL=http://127.0.0.1:8765
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8765/api/auth/google/callback
SESSION_TTL_SECONDS=2592000
# 账户字幕历史与会话的持久数据库；不会按任务 TTL 清理。
# HISTORY_DB_PATH=/absolute/private/path/accounts.sqlite3
